#!/usr/bin/env bash

set -e

scriptdir=$(dirname "$BASH_SOURCE[0]")
source $scriptdir/common

build_version="$(cat $repo_root/VERSION)-${git_version:=unknown}"

echo -e "$OK_COLOR==> Building Go source ${build_version} to ${build_dir} ...$NO_COLOR"
docker run $docker_run_opts \
  --volume $build_dir:/opt/src/github.com/nitrous-io/docker-registry-auth/bin \
  --volume $git_dir:/opt/src/github.com/nitrous-io/docker-registry-auth/.git:ro \
  -e BUILD_VERSION=$build_version \
  $image_name \
  ./script/ic-build
