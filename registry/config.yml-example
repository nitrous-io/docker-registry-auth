version: 0.1
log:
  level: info
  fields:
    service: registry
    environment: development
storage:
  cache:
    blobdescriptor: inmemory
  filesystem:
    rootdirectory: /var/lib/registry
auth:
  token:
    realm: http://host:5002/auth
    service: Docker registry
    issuer: Nitrous Registry Auth Service
    rootcertbundle: /etc/docker/registry/n2odev.crt
http:
  addr: :5000
  tls:
    certificate: /etc/docker/registry/n2odev.crt
    key: /etc/docker/registry/n2odev.key
  secret: asecretforlocaldevelopment
  headers:
    X-Content-Type-Options: [nosniff]
  debug:
    addr: :5001
notifications:
  endpoints:
    - name: nitrousd
      url: http://172.18.0.1:3333/api/v0/docker/registry/notifications
      headers:
        Authorization: [Bearer dev-shared-secret]
      timeout: 2s
      threshold: 3
      backoff: 2s
      disabled: false
health:
  storagedriver:
    enabled: true
    interval: 10s
    threshold: 3
